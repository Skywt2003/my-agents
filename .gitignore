# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/.playwright/

# build output
/.next/
/.next-e2e/
/out/
/release/

# legacy production output
/build

# local MyAgents data
/.myagents/

