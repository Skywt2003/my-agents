{
  "name": "my-agents",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "tsx src/web/server.ts",
    "dev:remote": "pnpm dev:web",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "pnpm build && electron-builder",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && node tests/e2e/run.mjs",
    "test:e2e:web": "node tests/e2e/run-web.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/codex-acp": "github:Skywt2003/codex-acp#4d5d3ccbc0cb8de4fc4e6a7aee672740b75b49dc",
    "@agentclientprotocol/sdk": "^1.3.0",
    "better-sqlite3": "^13.0.1",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@streamdown/cjk": "^1.0.3",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "lucide-react": "^1.28.0",
    "node-gyp": "12.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.16.1",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
